$breakpoint-small = 768px
$breakpoint-large = 1366px
$breakpoint-huge = 1920px
$space-between-nav-items = 16px

.mobile-navigation__flyout
  height 100%
  width 100%
  background linear-gradient(45deg, #009fe3 0%, #000 100%)
  color var(--white)
  position fixed
  top 16px
  left 0
  z-index var(--z-index-high)
  overflow auto
  visibility hidden
  opacity 0
  transition opacity 400ms cubic-bezier(0, 1.02, 0.48, 0.92)

  @media (min-width $breakpoint-small)
    box-shadow var(--elevation-m)

    .header__logo
      height 3rem
      margin-top 4px

      @media (min-width $breakpoint-medium)
        height 4rem
        margin-top 0

      @media (min-width $breakpoint-large)
        height 4rem

  @media (min-width $breakpoint-large)
    height auto
    padding-top 40px
    padding-bottom 40px

    .header__logo
      margin-top 0

  &--visible
    visibility visible
    opacity 1

  .input-icon
    margin 0 auto $space-between-nav-items
    max-width calc(100% - 30px)

    @media (min-width $breakpoint-small)
      margin-botom 0

    input
      outline none

.mobile-navigation__header
  position relative
  display flex
  align-items flex-start
  justify-content space-between
  padding 0
  margin-bottom 48px

  .button--icon-only
    padding 0
    height 22px

  .header__logo
    max-height 4rem

  .icon
    color var(--white)

  &--bars
    // &:after
    // content ''
    // position absolute
    // bottom 0
    // right 16px
    // width 0
    // height 0
    // border-left 8px solid transparent
    // border-right 8px solid transparent
    // border-bottom 8px solid var(--white)

  &--search
    &:after
      content ''
      position absolute
      bottom 0
      left 16px
      width 0
      height 0
      border-left 8px solid transparent
      border-right 8px solid transparent
      border-bottom 8px solid var(--aubergine)

.mobile-navigation__search
  flex 1
  margin-left 1.8rem
  position relative

  @media (min-width $breakpoint-small)
    display none

  .icon
    height 1.8rem
    width 3.6rem
    color var(--aubergine)
    position absolute
    left 0
    top 50%
    transform translateY(-50%)

.mobile-navgation__search-input
  width 100%
  padding-left 3.6rem
  // TODO: Refactor styles into generic <Input> component
  height 3.6rem
  font-size 1.3rem
  line-height 1.8rem
  color var(--neutral-90)
  background var(--neutral-00)
  border 1px solid var(--primary)
  border-radius 4px
  margin 0.6rem 0 0.4rem

.mobile-navigation__item
  display flex
  flex-direction column
  justify-content space-between
  charlie()
  font-weight var(--font-weight-medium)
  color var(--white)

  & + &
    border-top 1px solid var(--neutral-20)

  &:last-of-type
    border-bottom 1px solid var(--neutral-20)

  &--main
    delta()
    color var(--white)
    padding-left 1.5rem
    padding-right 1.5rem
    text-transform none
    margin-bottom 16px

  &--expanded
    border-bottom 1px solid var(--neutral-20)

  &--icon
    width 28px
    height 28px
    margin-right 8px

    svg
      width 28px
      height 28px

.mobile-navigation__link
  display flex
  align-items center
  justify-content space-between
  width 100%
  position relative
  word-break break-all

  &:hover
    cursor pointer

  .mobile-navigation__item--main > &
    justify-content space-between

.mobile-navigation__expand-icon
  height 1.8rem
  width 1.8rem

.mobile-navigation__subcategories
  padding-left 1.6rem

  .mobile-navigation__item
    margin-bottom 8px
    line-height 32px

  .mobile-navigation__link
    justify-content flex-start

  .mobile-navigation__item.mobile-navigation__item--no-subcats
    padding-left 3.2rem
    padding-right 15px

  .mobile-navigation__expand-icon
    margin-right 12px

.mobile-navigation__subcategories .mobile-navigation__subcategories
  padding-left 0

.mobile-navigation__subcategories .mobile-navigation__subcategories
  .mobile-navigation__item
    charlie()
    color var(--white)
    text-transform none
    line-height 32px

.mobile-navigation__info-links
  display flex
  flex-direction column
  margin-top 3rem
  padding-left 1.5rem

.mobile-navigation__info-link
  font-size 1.4rem
  line-height 1.8rem
  color var(--neutral-90)
  text-decoration none

  & + &
    margin-top 1.5rem

.navigation__header--wrapper
  padding 24px 15px 40px

  @media (min-width $breakpoint-small)
    padding 24px 27px 40px

  @media (min-width $breakpoint-medium)
    padding 0

  @media (min-width $breakpoint-large)
    padding 0
    margin 0

.navigation__header
  display flex
  justify-content space-between
  align-items flex-start

  @media (min-width $breakpoint-large)
    padding-bottom 24px

  .button--icon:not(.button--primary)
    height 22px
    padding 0
    color var(--white)
    margin-top 8px

    &:not(:last-child)
      margin-left 24px
      margin-right 24px

  @media (min-width $breakpoint-medium)
    .input-icon
      margin-top 24px

  @media (min-width $breakpoint-large)
    .button--icon:not(.button--primary)
      margin-top 8px

  &--actions
    display flex
    align-items flex-start
    justify-content space-between

    // min-height 88px
    @media (min-width $breakpoint-large)
      padding-top 0

    .input-icon .button--icon-only
      margin-top 0

.navigation__menu__wrapper
  @media (min-width $breakpoint-small)
    border-top 1px solid rgba(255, 255, 255, 0.2)

.navigation__menu
  display flex
  flex-direction column

  @media (min-width $breakpoint-small)
    max-width 83.33%

  @media (min-width $breakpoint-medium)
    max-width 100%

  @media (min-width $breakpoint-small)
    flex-direction row
    flex-wrap wrap
    margin-left auto
    margin-right auto
    padding-top 24px

    & > div
      width 50%

  @media (min-width 900px)
    flex-wrap nowrap

    .footer__tag-list
      margin-top 0 !important

  .navigation__menu__list
    display flex
    flex-direction row

    a
      :hover
        color var(--white)
        text-decoration underline

    & > div
      width calc(100% - 24px)
      margin-right 24px

      @media (min-width $breakpoint-small)
        margin-bottom 32px

      @media (min-width $breakpoint-large)
        margin-bottom 48px

  .heading
    font-weight var(--font-weight-medium)

.navigation__heading
  text-align left
  text-transform uppercase
  color var(--white)
  margin-bottom 16px

.navigation__subheading
  margin-bottom 16px
  word-break break-all
  display flex
  align-items center

.navigation__subheading--icon
  width 32px
  height 32px
  margin-right 8px

  svg
    width 32px
    height 32px

.mobile-navigation__flyout
  .footer__tag-list
    margin-top 16px

  @media (min-width $breakpoint-small)
    .navigation__header .input-icon
      margin-right $space-between-nav-items

  @media (min-width $breakpoint-large)
    .navigation__header .input-icon
      margin 0 $space-between-nav-items

  .desktop-navigation__wrapper
    display block

    .desktop-navigation
      height auto
      justify-content flex-end
      padding-bottom 24px

      @media (min-width $breakpoint-medium)
        margin-top 32px
        justify-content space-between

      @media (min-width $breakpoint-large)
        margin-top 0

    .desktop-navigation__item-link
      delta()
      color var(--white)
      cursor pointer
      margin-left 0
      margin-right 0

    .desktop-navigation__item:not(:last-child)
      .desktop-navigation__item-link
        margin-left $space-between-nav-items
        margin-right $space-between-nav-items

    .desktop-navigation__item:first-child
      .desktop-navigation__item-link
        margin-left 0

    .desktop-navigation__item .button--primary
      @media (min-width $breakpoint-large)
        margin-left $space-between-nav-items
        margin-right $space-between-nav-items
        margin-top 8px

    @media (min-width $breakpoint-large)
      border-bottom 0
      margin-right 0
      margin-top -8px

      .desktop-navigation
        padding-bottom 0

        @media (min-width $breakpoint-large)
          margin-right -24px

      .desktop-navigation__item-link
        echo()
        margin-left $space-between-nav-items
        margin-right $space-between-nav-items

      .navigation__header
        padding-bottom 16px
        border-bottom 1px solid rgba(255, 255, 255, 0.2)

      .input-icon
        margin 0

.desktop-navigation__item .button
  @media (min-width $breakpoint-large)
    margin-top 4px !important