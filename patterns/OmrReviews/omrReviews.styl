$breakpoint-huge = 1800px

.omr-reviews
  display flex
  flex-direction column

  &__wrapper
    display flex
    flex-direction column
    width 100%

  &__theme--white
    background var(--white)
    color var(--black)

    .heading
      color var(--primary)

    .copytext .text
      color var(--black)

  &__theme--primary
    background var(--radial-gradient)
    color var(--white)

    .heading
      color var(--white)

    .text
      color var(--white)

  &__theme--none
    color var(--white)

    .heading
      color var(--white)

    .text
      color var(--white)

  &__reduce-top-space
    padding-top 0

  &__reduce-max-width
    @media (min-width $breakpoint-huge)
      max-width var(--max-width)
      margin-left auto
      margin-right auto

  &__alignment--left
    text-align left

    .omr-reviews__wrapper
      margin-left 0

    .orm-reviews__link--wrapper
      margin-left 0

  &__alignment--right
    text-align right

    .omr-reviews__wrapper
      margin-right 0

    .orm-reviews__link--wrapper
      margin-right 0

  &__alignment--center
    text-align center

    .orm-reviews__link--wrapper
      margin-left auto
      margin-right auto

.orm-reviews__link
  width fit-content
  box-shadow var(--elevation-l)
  display inline-block
  border-radius 10px

  img
    border-radius 10px
    object-fit contain