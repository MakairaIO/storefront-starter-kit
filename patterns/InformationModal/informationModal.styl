.information-modal
  background var(--white)
  padding-top 6rem
  width calc(100% - 3.2rem)
  max-width 45rem
  top 50%
  transform translate(-50%, -50%)
  box-shadow 0 10px 15px -10px rgba(0,0,0,0.5)

  .modal__icon-wrapper
    display flex
    align-items center
    justify-content center

  .copytext
    text-align center

  .modal__button-row
    display flex
    justify-content center
    margin-top 2.4rem
  .icon--warning
    color var(--error)
    flex 0 0 2.5rem
    height 2.5rem
    margin-right 1rem
    margin 0.3rem 1rem 0 0
