$breakpoint-small = 500px
$breakpoint-medium = 768px
$breakpoint-large = 990px
$breakpoint-huge = 1800px

.card-2-col
  display grid
  gap 24px

  &__wrapper
    display grid
    gap 24px
    grid-auto-rows 1fr
    grid-template-columns 1fr

    @media (min-width $breakpoint-medium)
      grid-template-columns 1fr 1fr

  .card
    height 100%

    &__item
      height 100%
      display flex
      flex-direction column
      justify-content space-between
      text-align center
      border-radius 12px

      @media (min-width $breakpoint-large)
        max-width 500px

      @media (min-width $breakpoint-huge)
        max-width 700px

      .icon
        width 32px
        height 32px

        @media (min-width $breakpoint-medium)
          width 48px
          height 48px

      .heading
        margin 24px 0 8px
        text-align center

      .button
        charlie()

  &__image
    background-size contain
    background-position 50% 50%
    width 100%
    min-height 250px
    max-height 250px
    margin-bottom 24px
    border-radius 4px

  &--first-tile-smaller
    @media screen and (min-width $breakpoint-medium)
      grid-template-columns 33.33333% auto

  &--last-tile-smaller
    @media screen and (min-width $breakpoint-medium)
      grid-template-columns auto 33.33333%

  &__theme--primary
    background var(--radial-gradient)
    color var(--white)

    & .button
      color var(--primary)

    .card__item
      background-color var(--white)
      color var(--black)

  &__theme--white
    background-color var(--white)
    color var(--black)

    .card__item
      background-color var(--dark-primary)
      color var(--white)

    & .button
      color var(--white)

  &__theme--none
    background-color none
    color var(--white)

    .card__item
      background-color var(--white)
      color var(--black)

    & .button
      color var(--primary)

  &__reduce-top-space
    padding-top 0

  &__reduce-max-width
    @media (min-width $breakpoint_huge)
      max-width var(--max-width)
      margin-left auto
      margin-right auto
