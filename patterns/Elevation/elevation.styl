.elevation
  display block

  &--0
    box-shadow 0 1px 5px -3px rgba(0, 0, 0, 0.3)

  &--5
    box-shadow 0 2px 5px -3px rgba(0, 0, 0, 0.5), 0 1px 7px -3px rgba(0, 0, 0, 0.2)

  &--10
    box-shadow 0 3px 10px -5px rgba(0, 0, 0, 0.3)

  &--30
    box-shadow 0 4px 8px -1px rgba(0, 0, 0, 0.05), 0 8px 10px -3px rgba(0, 0, 0, 0.05), 0 8px 30px -4px rgba(0, 0, 0, 0.08)
